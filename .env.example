# Copy to backend/.env for local development. Never commit a filled-in copy.

ENVIRONMENT=development

# Postgres. Railway injects DATABASE_URL for its Postgres add-on; the app
# rewrites the postgres:// scheme it hands out to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://linx:linx@localhost:5432/linx_dev

# Used by the test suite. Point it at a throwaway database — the suite
# truncates every table between tests.
TEST_DATABASE_URL=postgresql+psycopg://linx:linx@localhost:5432/linx_test

# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses to run with the development default when ENVIRONMENT=production.
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated. In production this is the deployed origin; the single
# container serves the frontend from the same origin, so it is mostly moot.
CORS_ORIGINS=http://localhost:5173

# One region at launch. A display name, never a selector.
REGION_NAME=Greater Portland, ME
# Its IANA timezone. Every date a person reads, and the "same day" test behind
# the urgency ladder, are answered in this zone — never UTC.
REGION_TIMEZONE=America/New_York

# Platform cut in basis points (1500 = 15%). Read by phase 6.
PLATFORM_FEE_BPS=1500

# ---------------------------------------------------------------------------
# Vetting document uploads (phase 3)
#
# On Railway this MUST be a mounted volume. A container filesystem is replaced
# on every deploy, so without one the uploaded IDs disappear while their rows
# survive — the admin queue then points at files that are no longer there.
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=var/documents
MAX_DOCUMENT_BYTES=15728640

# ---------------------------------------------------------------------------
# Background checks (phase 3)
#
# With no key the manual provider is used and an admin records the outcome by
# hand — the launch posture. The Checkr client is written to the documented API
# but has never run against a real account; walk one candidate through a
# sandbox key before trusting it.
# ---------------------------------------------------------------------------
# CHECKR_API_KEY=
# CHECKR_PACKAGE=tasker_standard

# ---------------------------------------------------------------------------
# Stripe — phase 6. TEST MODE ONLY until the go-live gate.
#
# Test mode is fully sandboxed: no EIN, no SSN, no real money. Going live means
# a NEW Connect platform account under the new entity — never a personal SSN or
# an existing company's EIN, and never a migrated platform account.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
